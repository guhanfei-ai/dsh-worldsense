{
  "name": "dsh-worldsense",
  "version": "0.1.0",
  "description": "A safe, bounded, read-only perception layer for DeepSeek Harness agents: observe administrator-defined JSON APIs with provenance, snapshots and deterministic diffs — never an arbitrary HTTP client.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "check": "node --check index.js && find lib -name '*.js' -exec node --check {} \\; && find test -name '*.test.js' -exec node --check {} \\; && node --check examples/demo-server.mjs && node --check examples/worldsense-demo.mjs",
    "lint": "npm run check",
    "build": "npm run check",
    "test": "node --test",
    "demo": "node examples/worldsense-demo.mjs",
    "verify": "npm run check && npm test",
    "prepack": "npm run verify"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "docs",
    "examples",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.1.1-rc.0 || ^0.1.2-alpha.0 || ^0.1.3-alpha.0 || ^0.1.5-alpha.0 || ^0.1.5-rc.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1"
  },
  "engines": {
    "node": ">=22.5"
  },
  "keywords": [
    "deepseek",
    "harness",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "worldsense",
    "perception",
    "observability",
    "agent",
    "ai-agent",
    "json",
    "api",
    "read-only",
    "snapshot"
  ],
  "author": "guhanfei-ai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guhanfei-ai/dsh-worldsense.git"
  },
  "homepage": "https://github.com/guhanfei-ai/dsh-worldsense#readme",
  "bugs": {
    "url": "https://github.com/guhanfei-ai/dsh-worldsense/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  }
}
